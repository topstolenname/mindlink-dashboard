---
interface Props {
  title: string;
  description?: string;
  /** Use the bare title (no " — Tristan Jessup" suffix). */
  bareTitle?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Tristan Jessup — applied AI systems and integration. Agentic tooling, small models driving real tools, and evidence-first AI governance. Lexington, KY.',
  bareTitle = false,
  ogType = 'website',
} = Astro.props;

const currentPath = Astro.url.pathname;
const site = Astro.site ?? new URL('https://mindlink.dev');
const canonical = new URL(currentPath, site).href;
const ogImage = new URL('/og-image.png', site).href;
const fullTitle = bareTitle ? title : `${title} — Tristan Jessup`;

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/lab', label: 'Lab' },
];

const isActive = (href: string) =>
  currentPath === href || currentPath === `${href}/` || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tristan Jessup" />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="mindlink.dev" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Laughing Man logo beside the text: Tristan Jessup — Applied AI, AI integration, AI architecture" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-void-black text-text-secondary min-h-screen font-body">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[10000] bg-void-black text-terminal-green border border-terminal-green px-3 py-2 font-mono text-xs rounded">Skip to content</a>

    <!-- Matrix rain (easter egg: click the logo). Skipped when the visitor prefers reduced motion. -->
    <canvas id="matrix-canvas" class="fixed inset-0 z-[9999] pointer-events-none hidden opacity-40" aria-hidden="true"></canvas>

    <!-- Boot log (easter egg: press the ` key). -->
    <div id="boot-overlay" class="hidden fixed inset-0 z-[9998] bg-void-black/90 backdrop-blur-sm items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Boot log easter egg">
      <div class="w-full max-w-2xl border border-border-color rounded-lg overflow-hidden bg-void-black shadow-[0_0_40px_rgba(0,255,65,0.08)]">
        <div class="flex items-center justify-between px-4 py-2 border-b border-border-color">
          <span class="font-mono text-xs text-text-secondary/60">mindlink@bench ~ %</span>
          <button id="boot-close" class="font-mono text-xs text-text-secondary/60 hover:text-terminal-green bg-transparent border-none cursor-pointer">esc ✕</button>
        </div>
        <div id="boot-output" class="p-6 font-mono text-sm leading-relaxed min-h-[220px]"></div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border-color bg-void-black/95 backdrop-blur-sm" aria-label="Main">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <button
              id="laughing-man-logo"
              class="shrink-0 rounded-full bg-transparent border-none p-0 cursor-pointer ring-1 ring-border-color hover:ring-terminal-green transition"
              title="I thought what I'd do was, I'd pretend I was one of those deaf-mutes"
              aria-label="Laughing Man logo (easter egg)"
            >
              <img src="/img/laughing-man-96.webp" alt="" width="40" height="40" class="w-10 h-10 rounded-full block" />
            </button>
            <a href="/" class="flex flex-col leading-tight group">
              <span class="font-mono text-sm font-semibold text-text-secondary group-hover:text-terminal-green transition-colors">Tristan Jessup</span>
              <span class="font-mono text-[10px] text-terminal-green/70">mindlink.dev</span>
            </a>
          </div>

          <div class="hidden md:flex items-center gap-1">
            {navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'font-mono text-xs px-3 py-2 rounded transition-colors duration-200',
                  isActive(link.href)
                    ? 'text-terminal-green bg-terminal-green/10'
                    : link.href === '/lab'
                      ? 'text-text-secondary/50 hover:text-terminal-green hover:bg-terminal-green/5'
                      : 'text-text-secondary hover:text-terminal-green hover:bg-terminal-green/5',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>

          <button
            id="mobile-menu-btn"
            class="md:hidden text-text-secondary hover:text-terminal-green transition-colors bg-transparent border-none cursor-pointer"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-border-color mt-2 pt-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block font-mono text-xs px-3 py-2 rounded transition-colors duration-200',
                isActive(link.href) ? 'text-terminal-green bg-terminal-green/10' : 'text-text-secondary hover:text-terminal-green',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main id="main" class="pt-20 min-h-screen">
      <slot />
    </main>

    <footer class="border-t border-border-color mt-20 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h2 class="eyebrow mb-3">Elsewhere</h2>
            <ul class="flex flex-col gap-2 text-sm">
              <li><a href="https://github.com/topstolenname" class="text-text-secondary hover:text-terminal-green transition-colors" target="_blank" rel="noopener">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/john-jessup25/" class="text-text-secondary hover:text-terminal-green transition-colors" target="_blank" rel="noopener">LinkedIn</a></li>
              <li><a href="mailto:tristan@mindlink.dev" class="text-text-secondary hover:text-terminal-green transition-colors">tristan@mindlink.dev</a></li>
            </ul>
          </div>
          <div>
            <h2 class="eyebrow mb-3">Site</h2>
            <ul class="flex flex-col gap-2 text-sm">
              <li><a href="/work" class="text-text-secondary hover:text-terminal-green transition-colors">Work</a></li>
              <li><a href="/experience" class="text-text-secondary hover:text-terminal-green transition-colors">Experience</a></li>
              <li><a href="/writing" class="text-text-secondary hover:text-terminal-green transition-colors">Writing</a></li>
              <li><a href="/lab" class="text-text-secondary hover:text-terminal-green transition-colors">Lab &amp; archive</a></li>
            </ul>
          </div>
          <div>
            <h2 class="eyebrow mb-3">Mindlink Research Group</h2>
            <p class="text-sm text-text-secondary/70 leading-relaxed">
              The name I publish my independent research and tooling under.
            </p>
            <p class="text-sm text-text-secondary/70 leading-relaxed mt-3 italic">Inspired by myth, accountable to evidence.</p>
          </div>
        </div>
        <div class="border-t border-border-color mt-8 pt-6 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
          <p class="text-xs text-text-secondary/50 italic">
            “I thought what I'd do was, I'd pretend I was one of those deaf-mutes.”
            <span class="not-italic font-mono text-[10px] text-text-secondary/40">— The Laughing Man, <cite>Ghost in the Shell: Stand Alone Complex</cite></span>
          </p>
          <p class="font-mono text-xs text-text-secondary/40">&copy; {new Date().getFullYear()} Tristan Jessup</p>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --void-black: #050505;
        --terminal-green: #00ff41;
        --alert-amber: #ffb000;
        --text-secondary: #e0e0e0;
        --border-color: #333333;
      }

      html { scroll-behavior: smooth; }
      body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

      .fade-in { opacity: 0; transform: translateY(12px); transition: opacity 0.5s ease-out, transform 0.5s ease-out; }
      .fade-in.visible { opacity: 1; transform: translateY(0); }

      ::selection { background: rgba(0, 255, 65, 0.2); color: #00ff41; }
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: #050505; }
      ::-webkit-scrollbar-thumb { background: #333333; border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: #00ff41; }

      /* Small uppercase label above headings (replaces the old 01_ numbering). */
      .eyebrow {
        font-family: 'Fira Code', monospace;
        color: var(--terminal-green);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      a:focus-visible, button:focus-visible { outline: 2px solid var(--terminal-green); outline-offset: 2px; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .fade-in { opacity: 1; transform: none; transition: none; }
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      }
    </style>

    <script>
      function initSiteScripts() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Mobile menu
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        menuBtn?.addEventListener('click', () => {
          const hidden = mobileMenu?.classList.toggle('hidden');
          menuBtn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
        });

        // Fade-in on scroll
        const fades = document.querySelectorAll('.fade-in');
        if (reduceMotion || !('IntersectionObserver' in window)) {
          fades.forEach((el) => el.classList.add('visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
          );
          fades.forEach((el) => observer.observe(el));
        }

        // Matrix rain: subtle, short, opt-in (logo click), never with reduced motion
        const logo = document.getElementById('laughing-man-logo');
        const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement | null;
        let matrixActive = false;
        let animId: number | null = null;
        let timeoutId: ReturnType<typeof setTimeout> | null = null;

        function stopMatrix() {
          matrixActive = false;
          if (animId) cancelAnimationFrame(animId);
          if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
          canvas?.classList.add('hidden');
          const ctx = canvas?.getContext('2d');
          if (ctx && canvas) ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        logo?.addEventListener('click', () => {
          if (reduceMotion || !canvas) return;
          if (matrixActive) { stopMatrix(); return; }
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          matrixActive = true;
          canvas.classList.remove('hidden');
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          const fontSize = 14;
          const drops: number[] = new Array(Math.floor(canvas.width / fontSize)).fill(1);
          const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
          const draw = () => {
            if (!matrixActive) return;
            ctx.fillStyle = 'rgba(5, 5, 5, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#00ff41';
            ctx.font = `${fontSize}px 'Fira Code', monospace`;
            for (let i = 0; i < drops.length; i++) {
              ctx.fillText(chars[Math.floor(Math.random() * chars.length)], i * fontSize, drops[i] * fontSize);
              if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
              drops[i]++;
            }
            animId = requestAnimationFrame(draw);
          };
          draw();
          timeoutId = setTimeout(stopMatrix, 5000);
        });

        // Boot log: press ` (backtick) anywhere outside a form field; Esc closes
        const overlay = document.getElementById('boot-overlay');
        const out = document.getElementById('boot-output');
        const closeBtn = document.getElementById('boot-close');
        const bootLines: [string, string][] = [
          ['> mount ~/work', 'text-terminal-green'],
          ['  [ok] anvil            paused prototype, honest status', 'text-terminal-green/70'],
          ['  [ok] mcx-experiment   claims mapped to tests', 'text-terminal-green/70'],
          ['  [ok] emergent-div     nulls reported with the positives', 'text-terminal-green/70'],
          ['> verify --evidence', 'text-terminal-green'],
          ['  [ok] no unsourced numbers found', 'text-terminal-green/70'],
          ['', ''],
          ['  READY. Inspired by myth, accountable to evidence.', 'text-alert-amber'],
        ];
        let bootTimer: ReturnType<typeof setTimeout> | null = null;

        function closeBoot() {
          if (bootTimer) clearTimeout(bootTimer);
          overlay?.classList.add('hidden');
          overlay?.classList.remove('flex');
        }

        function openBoot() {
          if (!overlay || !out) return;
          out.textContent = '';
          overlay.classList.remove('hidden');
          overlay.classList.add('flex');
          closeBtn?.focus();
          let i = 0;
          const step = () => {
            if (i >= bootLines.length) return;
            const [text, cls] = bootLines[i++];
            const el = document.createElement('div');
            el.className = cls;
            el.textContent = text || '\u00a0';
            out.appendChild(el);
            bootTimer = setTimeout(step, reduceMotion ? 0 : 220);
          };
          step();
        }

        closeBtn?.addEventListener('click', closeBoot);
        overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeBoot(); });
        document.addEventListener('keydown', (e) => {
          const t = e.target as HTMLElement | null;
          if (t && (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName))) return;
          if (e.key === 'Escape') { closeBoot(); stopMatrix(); }
          else if (e.key === '`' && !e.metaKey && !e.ctrlKey && !e.altKey) {
            if (overlay?.classList.contains('hidden')) openBoot(); else closeBoot();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSiteScripts, { once: true });
      } else {
        initSiteScripts();
      }
    </script>
  </body>
</html>
