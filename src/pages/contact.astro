---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact Tristan Jessup about enterprise AI integration, AI solutions, and AI architecture roles.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12 fade-in">
      <p class="eyebrow">Contact</p>
      <h1 class="font-mono text-3xl font-bold text-text-secondary mt-2 mb-4">Let's talk</h1>
      <p class="text-lg text-text-secondary/80">
        I'm open to enterprise AI integration, AI solutions, and AI architecture roles, and happy to talk shop
        about agentic tooling and evidence-first AI. Based in the Lexington, Kentucky area.
      </p>
      <a href="/Tristan_Jessup_Resume.pdf" download class="inline-flex items-center gap-2 mt-5 font-mono text-sm border border-terminal-green text-terminal-green px-4 py-2 rounded hover:bg-terminal-green/10 transition-colors">Download resume (PDF)</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 fade-in">
      <!-- Email -->
      <a href="mailto:tristan@mindlink.dev" class="block border border-border-color rounded-lg p-6 hover:border-terminal-green/50 transition-all duration-300 group">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-5 h-5 text-terminal-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="font-mono text-sm font-semibold text-text-secondary group-hover:text-terminal-green transition-colors">Email</span>
        </div>
        <p class="font-mono text-sm text-terminal-green">tristan@mindlink.dev</p>
        <p class="text-xs text-text-secondary/50 mt-2">Best for roles, interviews, and project conversations</p>
      </a>

      <!-- GitHub -->
      <a href="https://github.com/topstolenname" target="_blank" rel="noopener" class="block border border-border-color rounded-lg p-6 hover:border-terminal-green/50 transition-all duration-300 group">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-5 h-5 text-terminal-green" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="font-mono text-sm font-semibold text-text-secondary group-hover:text-terminal-green transition-colors">GitHub</span>
        </div>
        <p class="font-mono text-sm text-terminal-green">@topstolenname</p>
        <p class="text-xs text-text-secondary/50 mt-2">Code for MCX, Emergent Divergence, and more</p>
      </a>

      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/in/john-jessup25/" target="_blank" rel="noopener" class="block border border-border-color rounded-lg p-6 hover:border-terminal-green/50 transition-all duration-300 group">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-5 h-5 text-terminal-green" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="font-mono text-sm font-semibold text-text-secondary group-hover:text-terminal-green transition-colors">LinkedIn</span>
        </div>
        <p class="font-mono text-sm text-terminal-green">Tristan Jessup</p>
        <p class="text-xs text-text-secondary/50 mt-2">Professional network and career history</p>
      </a>

      <!-- Mindlink Research Group -->
      <div class="border border-border-color rounded-lg p-6">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-5 h-5 text-terminal-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span class="font-mono text-sm font-semibold text-text-secondary">Mindlink Research Group</span>
        </div>
        <p class="text-sm text-text-secondary/70 leading-relaxed">
          The name I publish my independent research and tooling under. Not a company.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
