---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { caseStudies, smallerBuilds, toolchain } from '../data/work';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).map((p) => ({
  href: `/writing/${p.id}`, title: p.data.title, date: p.data.date, description: p.data.description, kind: 'Essay',
}));
const papers = (await getCollection('research')).map((p) => ({
  href: `/writing/${p.id}`, title: p.data.title, date: p.data.date, description: p.data.description, kind: 'Paper',
}));
const latest = [...posts, ...papers]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 2);
---

<BaseLayout
  title="Tristan Jessup — Applied AI systems & integration"
  bareTitle
  description="Tristan Jessup builds AI systems the way he fixes machines: diagnose, test, show the evidence. Senior Geek Squad bench technician, CompTIA A+/Network+/Security+, Apple Certified Repair Technician. Lexington, KY area."
>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16 sm:pt-20 sm:pb-20">
    <div class="grid grid-cols-1 md:grid-cols-[auto,1fr] gap-10 items-center">
      <div class="flex justify-center md:justify-start">
        <img
          id="hero-logo"
          src="/img/laughing-man-240.webp"
          data-anim="/img/laughing-man-anim.webp"
          data-static="/img/laughing-man-240.webp"
          alt="The Laughing Man logo, my avatar"
          width="176"
          height="176"
          class="w-36 h-36 sm:w-44 sm:h-44 rounded-full ring-1 ring-terminal-green/40 shadow-[0_0_40px_rgba(0,255,65,0.12)]"
        />
      </div>
      <div class="max-w-3xl">
        <p class="eyebrow">Applied AI · AI integration · AI architecture</p>
        <h1 class="font-mono text-3xl sm:text-4xl font-bold text-text-secondary mt-3 mb-5 leading-tight">
          I build AI systems the way I fix machines: diagnose, test, and show the evidence.
        </h1>
        <p class="text-lg leading-relaxed text-text-secondary/85">
          I'm Tristan Jessup, the most senior bench technician at Geek Squad (Best Buy Store #259), based in the
          Lexington, Kentucky area. I'm CompTIA A+, Network+ and Security+ certified and an Apple Certified Repair
          Technician. I design agentic
          tooling that pairs small language models with scripted tools, and I build governance experiments where
          every claim is mapped to a test. I'm working toward a B.S. in IT with an AI concentration and looking for
          enterprise AI integration and AI architecture roles.
        </p>
        <div class="flex flex-wrap gap-3 mt-7">
          <a href="/experience" class="font-mono text-sm border border-terminal-green text-terminal-green px-5 py-2.5 rounded hover:bg-terminal-green/10 transition-colors">View experience →</a>
          <a href="/work" class="font-mono text-sm border border-border-color text-text-secondary px-5 py-2.5 rounded hover:border-terminal-green hover:text-terminal-green transition-colors">See the work</a>
          <a href="/contact" class="font-mono text-sm border border-border-color text-text-secondary px-5 py-2.5 rounded hover:border-terminal-green hover:text-terminal-green transition-colors">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof points -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 fade-in">
    <p class="eyebrow">Selected work</p>
    <h2 class="font-mono text-xl font-semibold text-text-secondary mt-2 mb-2">Proof, not promises</h2>
    <p class="text-text-secondary/70 mb-8 max-w-3xl">Each case study links to what you can check for yourself, and says plainly what it doesn't show.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {caseStudies.map((item) => (
        <ProjectCard title={item.title} description={item.summary} status={item.status} href={item.href} evidence={item.evidence} tags={item.tags} />
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      {smallerBuilds.map((b) => (
        <div class="border border-border-color rounded-lg p-5">
          <h3 class="font-mono text-sm font-semibold text-text-secondary mb-2">{b.title}</h3>
          <p class="text-sm text-text-secondary/70 leading-relaxed">{b.summary}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Toolchain -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 fade-in">
    <p class="eyebrow">Daily toolchain</p>
    <ul class="flex flex-wrap gap-2 mt-4">
      {toolchain.map((t) => (
        <li class="font-mono text-xs text-text-secondary/85 bg-terminal-green/5 border border-border-color px-3 py-1.5 rounded">{t}</li>
      ))}
    </ul>
  </section>

  <!-- Latest writing (generated from content collections) -->
  {latest.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 fade-in">
      <p class="eyebrow">Latest writing</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
        {latest.map((w) => (
          <a href={w.href} class="block border border-border-color rounded-lg p-6 hover:border-terminal-green/50 transition-colors group">
            <div class="flex items-center gap-3 mb-2">
              <span class="font-mono text-[10px] text-terminal-green uppercase border border-terminal-green/50 px-2 py-0.5 rounded">{w.kind}</span>
              <span class="font-mono text-xs text-text-secondary/50">{w.date}</span>
            </div>
            <h3 class="font-mono text-base font-semibold text-text-secondary group-hover:text-terminal-green transition-colors mb-2">{w.title}</h3>
            <p class="text-sm text-text-secondary/70 leading-relaxed">{w.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-8 fade-in">
    <p class="font-mono text-sm text-text-secondary/60 italic">Inspired by myth, accountable to evidence.</p>
  </section>

  <script>
    // The hero logo spins (animated WebP, fetched on first hover/focus) only when motion is allowed.
    function initHeroLogo() {
      const img = document.getElementById('hero-logo') as HTMLImageElement | null;
      if (!img || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const anim = img.dataset.anim;
      const still = img.dataset.static;
      if (!anim || !still) return;
      const on = () => { img.src = anim; };
      const off = () => { img.src = still; };
      img.addEventListener('pointerenter', on);
      img.addEventListener('pointerleave', off);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroLogo, { once: true });
    } else {
      initHeroLogo();
    }
  </script>
</BaseLayout>
