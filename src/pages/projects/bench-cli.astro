---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Bench CLI" description="Command-line benchmarking tool for LLM evaluation">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-8 fade-in">
      <a href="/projects" class="font-mono text-xs text-terminal-green hover:text-alert-amber transition-colors mb-4 inline-block">← Back to Projects</a>
      <span class="section-number block mt-2">01_PROJECT // BENCH-CLI</span>
      <div class="flex items-center gap-3 mt-3 mb-4">
        <h1 class="font-mono text-3xl font-bold text-text-secondary">Bench CLI</h1>
        <span class="font-mono text-[10px] text-alert-amber uppercase px-2 py-0.5 border border-alert-amber rounded">In Progress</span>
      </div>
    </div>

    <div class="space-y-8 fade-in">
      <section>
        <span class="section-number">02_OVERVIEW</span>
        <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-4">What is Bench CLI?</h2>
        <div class="space-y-4 text-text-secondary/80 leading-relaxed">
          <p>
            Bench CLI is a command-line tool for systematically evaluating language model performance across
            structured tasks. It provides reproducible benchmarks with detailed scoring across dimensions
            like accuracy, coherence, instruction following, and reasoning depth.
          </p>
          <p>
            Built for researchers and developers who need to compare model capabilities without relying
            on leaderboard metrics that don't reflect real-world usage patterns.
          </p>
        </div>
      </section>

      <section>
        <span class="section-number">03_FEATURES</span>
        <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-4">Planned Features</h2>
        <div class="border border-border-color rounded-lg overflow-hidden">
          <div class="font-mono text-xs bg-void-black border-b border-border-color p-3 text-terminal-green">
            $ bench --help
          </div>
          <div class="p-4 font-mono text-sm text-text-secondary/80 space-y-2">
            <p class="text-text-secondary">Usage: bench [command] [options]</p>
            <p>&nbsp;</p>
            <p>Commands:</p>
            <p class="pl-4">run &lt;suite&gt; &nbsp;&nbsp;&nbsp; Run a benchmark suite</p>
            <p class="pl-4">compare &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Compare results across models</p>
            <p class="pl-4">report &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Generate evaluation report</p>
            <p class="pl-4">list &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; List available benchmark suites</p>
            <p>&nbsp;</p>
            <p>Options:</p>
            <p class="pl-4">--model &lt;id&gt; &nbsp;&nbsp; Target model identifier</p>
            <p class="pl-4">--format &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Output format (json, csv, markdown)</p>
            <p class="pl-4">--verbose &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Show detailed scoring breakdown</p>
          </div>
        </div>
      </section>

      <section>
        <span class="section-number">04_STACK</span>
        <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-4">Tech Stack</h2>
        <div class="flex flex-wrap gap-2">
          {['Python', 'Click', 'asyncio', 'JSON Schema', 'Markdown Reports'].map((tech) => (
            <span class="font-mono text-xs text-text-secondary/80 bg-terminal-green/5 border border-border-color px-3 py-1 rounded">
              {tech}
            </span>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
