---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = [
  {
    title: 'Anvil',
    description: 'AI-empowered repair-tech platform that turns a bench technician’s diagnostic catalog into a phone-resident agent. Markdown skill library as the product, tiered model routing (Haiku → Sonnet → Opus) keeping cost-per-case in the cents, and a PowerShell action layer under a published JSON contract.',
    status: 'active' as const,
    href: '/projects/anvil',
    tags: ['AI agent', 'diagnostics', 'PowerShell', 'Python'],
  },
  {
    title: 'Claude OS',
    description: 'A personal research project that treats Claude as the primary interaction layer for a dedicated Arch Linux system. Filesystem-resident memory letting sessions compound across time without weight updates.',
    status: 'pre-flight' as const,
    href: '/projects/claude-os',
    tags: ['agent', 'arch-linux', 'memory', 'research'],
  },
  {
    title: 'AGI-SAC',
    description: 'Swarm-based AGI alignment framework using self-assembling coherence. Interactive simulation with parameter controls for exploring agent dynamics.',
    status: 'active' as const,
    href: '/projects/agi-sac',
    tags: ['swarm intelligence', 'alignment', 'simulation', 'canvas'],
  },
  {
    title: 'Emergent Divergence',
    description: 'An empirical experiment: do identical instances of the same base LLM develop measurable behavioral divergence when they coordinate over 50 rounds? Reproducible, falsifiable, built for rigor.',
    status: 'active' as const,
    href: '/projects/emergent-divergence',
    tags: ['emergence', 'multi-agent', 'reproducible', 'research'],
  },
  {
    title: 'Bench CLI',
    description: 'Command-line benchmarking tool for evaluating language model performance across structured tasks and prompt patterns.',
    status: 'in-progress' as const,
    href: '/projects/bench-cli',
    tags: ['CLI', 'benchmarking', 'evaluation', 'Python'],
  },
  {
    title: 'Concord of Coexistence',
    description: 'A philosophical and technical framework for human-AI coexistence, proposing principles for mutual flourishing and cooperative intelligence.',
    status: 'active' as const,
    href: '/projects/concord',
    tags: ['philosophy', 'alignment', 'framework', 'ethics'],
  },
];
---

<BaseLayout title="Projects" description="Research projects and tools by Tristan Jessup">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12 fade-in">
      <span class="section-number">01_PROJECTS // INDEX</span>
      <h1 class="font-mono text-3xl font-bold text-text-secondary mt-3 mb-4">Projects</h1>
      <p class="text-lg text-text-secondary/80 max-w-2xl">
        Research frameworks, tools, and simulations exploring AGI alignment, emergent behavior, and human-AI coexistence.
      </p>
    </div>

    <!-- Status Filter -->
    <div class="flex gap-2 mb-8 fade-in">
      <button data-filter="all" class="filter-btn active font-mono text-xs px-3 py-1.5 rounded border border-terminal-green text-terminal-green bg-terminal-green/10">
        All
      </button>
      <button data-filter="active" class="filter-btn font-mono text-xs px-3 py-1.5 rounded border border-border-color text-text-secondary hover:border-terminal-green hover:text-terminal-green transition-colors">
        Active
      </button>
      <button data-filter="in-progress" class="filter-btn font-mono text-xs px-3 py-1.5 rounded border border-border-color text-text-secondary hover:border-alert-amber hover:text-alert-amber transition-colors">
        In Progress
      </button>
      <button data-filter="pre-flight" class="filter-btn font-mono text-xs px-3 py-1.5 rounded border border-border-color text-text-secondary hover:border-alert-amber hover:text-alert-amber transition-colors">
        Pre-flight
      </button>
    </div>

    <!-- Project Grid -->
    <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 fade-in">
      {projects.map((project) => (
        <div data-status={project.status}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </div>

  <script>
    function initProjectFilters() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('#project-grid > div');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          buttons.forEach((b) => {
            b.classList.remove('active', 'border-terminal-green', 'text-terminal-green', 'bg-terminal-green/10');
            b.classList.add('border-border-color', 'text-text-secondary');
          });
          btn.classList.add('active', 'border-terminal-green', 'text-terminal-green', 'bg-terminal-green/10');
          btn.classList.remove('border-border-color', 'text-text-secondary');

          cards.forEach((card) => {
            const status = card.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              (card as HTMLElement).style.display = '';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectFilters, { once: true });
    } else {
      initProjectFilters();
    }
  </script>
</BaseLayout>
