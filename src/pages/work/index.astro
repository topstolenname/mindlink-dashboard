---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { caseStudies, smallerBuilds } from '../../data/work';
---

<BaseLayout title="Work" description="Case studies by Tristan Jessup: MCX (Meta-Concord reference implementation), Emergent Divergence (multi-agent experiment), and Anvil (tiered agentic diagnostics).">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-12 fade-in max-w-3xl">
      <p class="eyebrow">Work</p>
      <h1 class="font-mono text-3xl font-bold text-text-secondary mt-2 mb-4">Case studies</h1>
      <p class="text-lg text-text-secondary/80">
        Each one covers the problem, what I built, the evidence you can open, and what it does
        <em>not</em> show. The status labels are honest: active, pilot, or paused.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 fade-in">
      {caseStudies.map((item) => (
        <ProjectCard title={item.title} description={item.summary} status={item.status} href={item.href} evidence={item.evidence} tags={item.tags} />
      ))}
    </div>

    <section class="mt-14 fade-in">
      <p class="eyebrow">Smaller builds</p>
      <h2 class="font-mono text-xl font-semibold text-text-secondary mt-2 mb-6">Practical automation and security</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {smallerBuilds.map((b) => (
          <div class="border border-border-color rounded-lg p-6">
            <h3 class="font-mono text-base font-semibold text-text-secondary mb-2">{b.title}</h3>
            <p class="text-sm text-text-secondary/75 leading-relaxed mb-4">{b.summary}</p>
            <div class="flex flex-wrap gap-2">
              {b.tags.map((t) => <span class="font-mono text-[10px] text-terminal-green/70 bg-terminal-green/5 px-2 py-0.5 rounded">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-12 text-sm text-text-secondary/60 fade-in">
      Older experiments and concepts live in the <a href="/lab" class="text-terminal-green hover:text-alert-amber transition-colors">Lab &amp; archive</a>.
    </p>
  </div>
</BaseLayout>
