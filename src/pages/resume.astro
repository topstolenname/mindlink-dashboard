---
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
  {
    degree: 'B.S. Information Technology',
    concentration: 'AI Concentration',
    school: 'Strayer University',
    period: 'In Progress',
  },
  {
    degree: 'General Studies Coursework',
    school: 'University of Kentucky',
    period: '2008 — 2010',
  },
];

const experience = [
  {
    title: 'Founder & Independent Researcher',
    org: 'Mindlink Research Group LLC',
    period: '2025 — Present',
    description: 'Run multi-agent empirical experiments on emergent behavior and design governance frameworks that treat alignment as a group-level property. Built AGI-SAC (testing whether persistent memory alone drives behavioral divergence between identical-base-model LLM agents) and authored the Concord of Coexistence alignment framework.',
  },
  {
    title: 'Advanced Repair Agent',
    org: 'Best Buy / Geek Squad',
    period: 'Apr 2021 — Present',
    description: 'Senior technical resource on the bench — mentor associates and own the most complex escalations. Diagnose and repair hardware/software faults across Windows and macOS, including data recovery, NVMe/SSD cloning and migration, BIOS/UEFI issues, and malware remediation.',
  },
];

const certifications = [
  { name: 'CompTIA Security+', status: 'Certified' },
  { name: 'CompTIA Network+', status: 'Certified' },
  { name: 'CompTIA A+', status: 'Certified' },
];

const skills = {
  'AI / ML & Research': ['Multi-Agent Systems', 'LLM Evaluation & Behavioral Analysis', 'AI Alignment & Safety', 'Governance-Framework Design', 'Statistical Analysis'],
  'Tools & Platforms': ['Anthropic Claude / Claude Code', 'Google Vertex AI', 'Google Cloud Platform', 'Microsoft 365 / Copilot Studio', 'Obsidian', 'Git'],
  'Systems & Hardware': ['Windows & macOS Diagnostics', 'Linux (Kubuntu)', 'Data Recovery', 'NVMe/SSD Cloning & Migration', 'BIOS/UEFI', 'Endpoint Security & Malware Remediation'],
};
---

<BaseLayout title="Resume" description="Tristan Jessup — Resume / CV">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="mb-12 fade-in">
      <span class="section-number">01_RESUME // CURRICULUM VITAE</span>
      <h1 class="font-mono text-3xl font-bold text-text-secondary mt-3 mb-4">Tristan Jessup</h1>
      <p class="text-lg text-text-secondary/80 mb-6">Independent AI Alignment Researcher · Founder, Mindlink Research Group LLC · Advanced Repair Agent, Geek Squad</p>
      <a
        href="/Tristan_Jessup_Resume.pdf"
        target="_blank"
        rel="noopener"
        download
        class="inline-flex items-center gap-2 font-mono text-sm border border-border-color text-text-secondary px-4 py-2 rounded hover:border-terminal-green hover:text-terminal-green transition-colors"
        title="Download resume (PDF)"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download PDF
      </a>
    </div>

    <!-- Education -->
    <section class="mb-12 fade-in">
      <span class="section-number">02_EDUCATION</span>
      <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-6">Education</h2>
      <div class="space-y-4">
        {education.map((edu) => (
          <div class="border border-border-color rounded-lg p-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
              <h3 class="font-mono text-base font-semibold text-text-secondary">{edu.degree}</h3>
              <span class="font-mono text-xs text-alert-amber">{edu.period}</span>
            </div>
            {edu.concentration && <p class="text-sm text-terminal-green mt-1">{edu.concentration}</p>}
            <p class="text-sm text-text-secondary/70 mt-1">{edu.school}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="mb-12 fade-in">
      <span class="section-number">03_EXPERIENCE // TIMELINE</span>
      <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-6">Experience</h2>
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-border-color"></div>

        <div class="space-y-8">
          {experience.map((job) => (
            <div class="relative pl-8">
              <!-- Timeline dot -->
              <div class="absolute left-0 top-2 w-[15px] h-[15px] rounded-full border-2 border-terminal-green bg-void-black"></div>
              <div class="border border-border-color rounded-lg p-6 hover:border-terminal-green/30 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                  <h3 class="font-mono text-base font-semibold text-text-secondary">{job.title}</h3>
                  <span class="font-mono text-xs text-alert-amber">{job.period}</span>
                </div>
                <p class="font-mono text-sm text-terminal-green/80 mb-3">{job.org}</p>
                <p class="text-sm text-text-secondary/70 leading-relaxed">{job.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-12 fade-in">
      <span class="section-number">04_CERTIFICATIONS</span>
      <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-6">Certifications</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {certifications.map((cert) => (
          <div class="border border-border-color rounded-lg p-4 text-center hover:border-terminal-green/30 transition-colors">
            <div class="font-mono text-sm font-semibold text-text-secondary mb-1">{cert.name}</div>
            <div class="font-mono text-[10px] text-terminal-green uppercase">{cert.status}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills Matrix -->
    <section class="mb-12 fade-in">
      <span class="section-number">05_SKILLS // MATRIX</span>
      <h2 class="font-mono text-xl font-semibold text-text-secondary mt-3 mb-6">Skills</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {Object.entries(skills).map(([category, items]) => (
          <div class="border border-border-color rounded-lg p-6">
            <h3 class="font-mono text-sm font-semibold text-terminal-green mb-4">{category}</h3>
            <div class="flex flex-wrap gap-2">
              {items.map((skill) => (
                <span class="font-mono text-xs text-text-secondary/80 bg-terminal-green/5 border border-border-color px-3 py-1 rounded">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
